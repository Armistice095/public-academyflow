---
// Icônes de systèmes d'exploitation (Windows, macOS, Linux), en SVG monochrome
// (currentColor) pour s'adapter automatiquement au thème clair/sombre.
// Il s'agit de représentations simplifiées et originales, pas d'une reproduction
// exacte des logos déposés de Microsoft/Apple — usage purement fonctionnel,
// pour indiquer la compatibilité de la plateforme.
const { name, class: className = 'h-6 w-6' } = Astro.props;

interface Props {
  name: 'windows' | 'mac' | 'linux';
  class?: string;
}
---

{
  name === 'windows' && (
    <svg
      viewBox="0 0 24 24"
      class={className}
      fill="currentColor"
      xmlns="http://www.w3.org/2000/svg"
    >
      <rect x="2" y="2" width="9" height="9" rx="0.6" />
      <rect x="13" y="2" width="9" height="9" rx="0.6" />
      <rect x="2" y="13" width="9" height="9" rx="0.6" />
      <rect x="13" y="13" width="9" height="9" rx="0.6" />
    </svg>
  )
}

{
  name === 'mac' && (
    <svg
      viewBox="0 0 24 24"
      class={className}
      fill="currentColor"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M16.7 12.7c0-2.1 1.7-3.2 1.8-3.2-1-1.4-2.5-1.6-3-1.6-1.3-.1-2.5.8-3.1.8-.6 0-1.6-.7-2.7-.7-1.4 0-2.6.8-3.3 2-1.4 2.5-.4 6.1 1 8.1.7 1 1.5 2.1 2.6 2 1-.1 1.4-.7 2.7-.7s1.6.7 2.7.6c1.1 0 1.8-1 2.5-2 .8-1.1 1.1-2.2 1.1-2.3 0 0-2.2-.8-2.3-3z"
      />
      <path
        d="M14.2 6.4c.6-.7 1-1.7.9-2.6-.8.1-1.9.6-2.5 1.3-.5.6-1 1.6-.9 2.5.9.1 1.8-.4 2.5-1.2z"
      />
    </svg>
  )
}

{
  name === 'linux' && (
    <svg
      viewBox="0 0 24 24"
      class={className}
      xmlns="http://www.w3.org/2000/svg"
    >
      <ellipse cx="12" cy="7.3" rx="2.6" ry="2.8" fill="currentColor" />
      <path
        fill="currentColor"
        d="M8.7 9.6c-1.6 1.1-2.7 3.3-2.9 5.7-.2 2.1.3 3.8 1.3 4.4.5.3.9-.1 1.4-.4.5-.3 1.1-.3 1.6 0 .6.4 1.2.7 1.9.7s1.3-.3 1.9-.7c.5-.3 1.1-.3 1.6 0 .5.3.9.7 1.4.4 1-.6 1.5-2.3 1.3-4.4-.2-2.4-1.3-4.6-2.9-5.7-.5.9-1.5 1.5-3.3 1.5s-2.8-.6-3.3-1.5z"
      />
      <ellipse
        cx="12"
        cy="15.5"
        rx="2.3"
        ry="3.4"
        class="fill-neutral-100 dark:fill-neutral-900"
      />
      <circle cx="10.9" cy="6.9" r="0.55" class="fill-neutral-100 dark:fill-neutral-900" />
      <circle cx="13.1" cy="6.9" r="0.55" class="fill-neutral-100 dark:fill-neutral-900" />
      <path d="M11.6 7.9l.4.7.4-.7z" fill="#f4a300" />
      <path
        fill="currentColor"
        d="M6.4 18.5c-.3.9-.9 1.6-.9 1.6s1.1.2 1.9-.3c.3-.6.4-1.1.4-1.1z"
      />
      <path
        fill="currentColor"
        d="M17.6 18.5c.3.9.9 1.6.9 1.6s-1.1.2-1.9-.3c-.3-.6-.4-1.1-.4-1.1z"
      />
      <ellipse cx="10.3" cy="21.3" rx="1" ry="0.5" fill="#f4a300" />
      <ellipse cx="13.7" cy="21.3" rx="1" ry="0.5" fill="#f4a300" />
    </svg>
  )
}
