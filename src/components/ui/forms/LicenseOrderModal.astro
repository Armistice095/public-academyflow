---
// Modale unique réutilisée pour "Choisir Standard", "Choisir Premium" et
// "Renouveler ma licence". Le contenu (titre, champs visibles, plan) est
// ajusté côté client selon le bouton qui a ouvert la modale.
import { BACKEND } from '@data/constants';

const config = {
  id: 'license-order-modal',
};
---

<div
  id={config.id}
  class="hs-overlay hs-overlay-backdrop-open:bg-neutral-900/90 absolute start-0 top-0 z-50 hidden h-full w-full"
  data-lenis-prevent
>
  <div
    class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 m-3 mt-0 opacity-0 transition-all ease-out sm:mx-auto sm:w-full sm:max-w-lg"
  >
    <div class="mx-auto w-full max-w-md p-6">
      <div
        class="mt-7 flex max-h-[calc(100vh-8rem)] flex-col rounded-xl border border-neutral-200 bg-neutral-100 shadow-xs dark:border-neutral-700 dark:bg-neutral-800"
      >
        <div class="overflow-y-auto p-4 sm:p-7">
          {/* En-tête : titre dynamique + bouton fermer */}
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2
                id="license-modal-title"
                class="block text-2xl font-bold text-neutral-800 dark:text-neutral-200"
              >
                Choisir une formule
              </h2>
              <p
                id="license-modal-subtitle"
                class="mt-2 text-sm text-neutral-600 dark:text-neutral-400"
              >
                Remplissez vos informations pour continuer.
              </p>
            </div>
            <button
              type="button"
              data-hs-overlay={`#${config.id}`}
              aria-label="Fermer"
              class="inline-flex shrink-0 items-center justify-center rounded-full p-1.5 text-neutral-500 ring-zinc-500 outline-hidden hover:bg-neutral-200 focus-visible:ring-3 dark:text-neutral-400 dark:hover:bg-neutral-700"
            >
              <svg
                class="h-5 w-5"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
              </svg>
            </button>
          </div>

          {/* Bandeau d'erreur générique (404 / 409 / 500 / erreurs réseau) */}
          <div
            id="license-error-banner"
            class="mt-4 hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-800 dark:bg-red-900/20 dark:text-red-400"
            role="alert"
          ></div>

          <div id="license-form-wrapper">
          <form id="license-order-form" class="mt-5" novalidate>
            {/* Champs cachés déterminant le mode courant */}
            <input type="hidden" name="type" id="license-order-type" value="new_purchase" />
            <input type="hidden" name="plan" id="license-plan-hidden" value="standard" />

            <div class="grid gap-y-4">
              {/* Sélecteur de plan, affiché uniquement pour un renouvellement */}
              <div id="license-plan-field" class="hidden">
                <label
                  for="plan-input"
                  class="mb-2 block text-sm text-neutral-800 dark:text-neutral-200"
                  >Formule souhaitée</label
                >
                <select
                  id="plan-input"
                  name="plan-select"
                  class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden dark:border-neutral-600 dark:bg-neutral-700/30 dark:text-neutral-300 dark:focus:ring-1"
                >
                  <option value="standard">Standard — 50 000 FCFA / an</option>
                  <option value="premium">Premium — 92 000 FCFA / an</option>
                </select>
                <p class="mt-1 hidden text-xs text-red-600" id="plan-error"></p>
              </div>

              {/* Clé de licence existante, affichée uniquement pour un renouvellement */}
              <div id="license-key-field" class="hidden">
                <label
                  for="existingLicenseKey-input"
                  class="mb-2 block text-sm text-neutral-800 dark:text-neutral-200"
                  >Clé de licence actuelle</label
                >
                <input
                  type="text"
                  id="existingLicenseKey-input"
                  name="existingLicenseKey"
                  placeholder="AF-XXXX-XXXX-XXXX-XXXX"
                  autocomplete="off"
                  class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 uppercase placeholder:normal-case placeholder:text-neutral-500 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden dark:border-neutral-600 dark:bg-neutral-700/30 dark:text-neutral-300 dark:placeholder:text-neutral-400 dark:focus:ring-1"
                />
                <p class="mt-1 hidden text-xs text-red-600" id="existingLicenseKey-error"></p>
              </div>

              {/* Nom du responsable */}
              <div>
                <label
                  for="buyerName-input"
                  class="mb-2 block text-sm text-neutral-800 dark:text-neutral-200"
                  >Nom du responsable</label
                >
                <input
                  type="text"
                  id="buyerName-input"
                  name="buyerName"
                  autocomplete="name"
                  class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden dark:border-neutral-600 dark:bg-neutral-700/30 dark:text-neutral-300 dark:focus:ring-1"
                />
                <p class="mt-1 hidden text-xs text-red-600" id="buyerName-error"></p>
              </div>

              {/* Email */}
              <div>
                <label
                  for="buyerEmail-input"
                  class="mb-2 block text-sm text-neutral-800 dark:text-neutral-200"
                  >Adresse e-mail</label
                >
                <input
                  type="email"
                  id="buyerEmail-input"
                  name="buyerEmail"
                  autocomplete="email"
                  class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden dark:border-neutral-600 dark:bg-neutral-700/30 dark:text-neutral-300 dark:focus:ring-1"
                />
                <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
                  Tu recevras ta licence à cette adresse.
                </p>
                <p class="mt-1 hidden text-xs text-red-600" id="buyerEmail-error"></p>
              </div>

              {/* Nom de l'établissement */}
              <div>
                <label
                  for="schoolName-input"
                  class="mb-2 block text-sm text-neutral-800 dark:text-neutral-200"
                  >Nom de l'établissement <span class="text-neutral-400">(optionnel)</span
                  ></label
                >
                <input
                  type="text"
                  id="schoolName-input"
                  name="schoolName"
                  class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden dark:border-neutral-600 dark:bg-neutral-700/30 dark:text-neutral-300 dark:focus:ring-1"
                />
                <p class="mt-1 hidden text-xs text-red-600" id="schoolName-error"></p>
              </div>

              {/* Téléphone */}
              <div>
                <label
                  for="buyerPhone-input"
                  class="mb-2 block text-sm text-neutral-800 dark:text-neutral-200"
                  >Téléphone <span class="text-neutral-400">(optionnel)</span></label
                >
                <input
                  type="tel"
                  id="buyerPhone-input"
                  name="buyerPhone"
                  placeholder="22997000000"
                  class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 placeholder:text-neutral-500 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden dark:border-neutral-600 dark:bg-neutral-700/30 dark:text-neutral-300 dark:placeholder:text-neutral-400 dark:focus:ring-1"
                />
                <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
                  Numéro Mobile Money, sans le +.
                </p>
                <p class="mt-1 hidden text-xs text-red-600" id="buyerPhone-error"></p>
              </div>

              {/* Adresse de l'établissement */}
              <div>
                <label
                  for="schoolAddress-input"
                  class="mb-2 block text-sm text-neutral-800 dark:text-neutral-200"
                  >Adresse de l'établissement <span class="text-neutral-400"
                    >(optionnel)</span
                  ></label
                >
                <input
                  type="text"
                  id="schoolAddress-input"
                  name="schoolAddress"
                  class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden dark:border-neutral-600 dark:bg-neutral-700/30 dark:text-neutral-300 dark:focus:ring-1"
                />
                <p class="mt-1 hidden text-xs text-red-600" id="schoolAddress-error"></p>
              </div>

              {/* Bouton de soumission */}
              <button
                type="submit"
                id="license-submit-btn"
                class="inline-flex items-center justify-center gap-x-2 rounded-lg bg-yellow-400 px-4 py-3 text-center text-sm font-bold text-neutral-800 ring-zinc-500 outline-hidden transition duration-300 hover:bg-yellow-300 focus-visible:ring-3 disabled:pointer-events-none disabled:opacity-60 dark:ring-zinc-200"
              >
                <svg
                  id="license-submit-spinner"
                  class="hidden h-4 w-4 animate-spin"
                  viewBox="0 0 24 24"
                  fill="none"
                >
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="4"></circle>
                  <path
                    class="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
                <span id="license-submit-label">Continuer</span>
              </button>
            </div>
          </form>
          </div>

          {/* Vue de succès pour l'essai gratuit (pas de redirection, juste un message) */}
          <div id="license-success-view" class="mt-5 hidden text-center">
            <div
              class="mx-auto mb-4 inline-flex h-12 w-12 items-center justify-center rounded-full bg-green-100 dark:bg-green-900/30"
            >
              <svg
                class="h-6 w-6 text-green-600 dark:text-green-400"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 6 9 17l-5-5"></path>
              </svg>
            </div>
            <p
              id="license-success-message"
              class="text-sm text-neutral-700 dark:text-neutral-300"
            >
            </p>
            <button
              type="button"
              data-hs-overlay={`#${config.id}`}
              class="mt-6 inline-flex items-center justify-center rounded-lg bg-yellow-400 px-4 py-3 text-center text-sm font-bold text-neutral-800 ring-zinc-500 outline-hidden transition duration-300 hover:bg-yellow-300 focus-visible:ring-3 dark:ring-zinc-200"
            >
              Fermer
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ BACKEND_URL: BACKEND.baseUrl }}>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('license-order-modal');
    if (!modal) return;

    const form = document.getElementById('license-order-form');
    const formWrapper = document.getElementById('license-form-wrapper');
    const successView = document.getElementById('license-success-view');
    const successMessage = document.getElementById('license-success-message');
    const titleEl = document.getElementById('license-modal-title');
    const subtitleEl = document.getElementById('license-modal-subtitle');
    const typeHidden = document.getElementById('license-order-type');
    const planHidden = document.getElementById('license-plan-hidden');
    const planField = document.getElementById('license-plan-field');
    const planInput = document.getElementById('plan-input');
    const keyField = document.getElementById('license-key-field');
    const keyInput = document.getElementById('existingLicenseKey-input');
    const submitBtn = document.getElementById('license-submit-btn');
    const submitLabel = document.getElementById('license-submit-label');
    const submitSpinner = document.getElementById('license-submit-spinner');
    const errorBanner = document.getElementById('license-error-banner');

    const LICENSE_KEY_REGEX =
      /^AF-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}$/i;
    const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function clearErrors() {
      errorBanner.classList.add('hidden');
      errorBanner.textContent = '';
      form.querySelectorAll('[id$="-error"]').forEach(el => {
        el.classList.add('hidden');
        el.textContent = '';
      });
      form.querySelectorAll('input, select').forEach(el => {
        el.classList.remove('border-red-400', 'focus:ring-red-400');
      });
    }

    function showFieldError(field, message) {
      const errorEl = document.getElementById(`${field}-error`);
      if (!errorEl) return false;
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
      const inputEl = document.getElementById(`${field}-input`);
      inputEl?.classList.add('border-red-400', 'focus:ring-red-400');
      return true;
    }

    function showBannerError(message) {
      errorBanner.textContent = message;
      errorBanner.classList.remove('hidden');
    }

    function setLoading(isLoading) {
      submitBtn.disabled = isLoading;
      submitSpinner.classList.toggle('hidden', !isLoading);
      submitLabel.textContent = isLoading
        ? 'Envoi en cours…'
        : submitBtn.dataset.defaultLabel || 'Continuer';
    }

    function configureModal(type, plan) {
      form.reset();
      clearErrors();
      setLoading(false);
      formWrapper.classList.remove('hidden');
      successView.classList.add('hidden');
      typeHidden.value = type;

      if (type === 'renewal') {
        titleEl.textContent = 'Renouveler ma licence';
        subtitleEl.textContent =
          'Indique ta clé de licence actuelle et la formule souhaitée.';
        planField.classList.remove('hidden');
        keyField.classList.remove('hidden');
        keyInput.required = true;
        planInput.value = plan || 'standard';
        submitBtn.dataset.defaultLabel = 'Continuer';
      } else if (type === 'trial') {
        titleEl.textContent = 'Essai gratuit de 5 jours';
        subtitleEl.textContent =
          "Aucune carte requise. Ta clé d'essai arrive par e-mail.";
        planField.classList.add('hidden');
        keyField.classList.add('hidden');
        keyInput.required = false;
        submitBtn.dataset.defaultLabel = 'Commencer gratuitement';
      } else {
        titleEl.textContent =
          plan === 'premium' ? 'Choisir Premium' : 'Choisir Standard';
        subtitleEl.textContent =
          'Renseigne tes informations, tu seras redirigé vers le paiement.';
        planField.classList.add('hidden');
        keyField.classList.add('hidden');
        keyInput.required = false;
        planHidden.value = plan || 'standard';
        submitBtn.dataset.defaultLabel = 'Continuer';
      }
      submitLabel.textContent = submitBtn.dataset.defaultLabel;
    }

    // Ouverture de la modale depuis un bouton "déclencheur"
    document.querySelectorAll('[data-license-trigger]').forEach(btn => {
      btn.addEventListener('click', () => {
        configureModal(
          btn.getAttribute('data-order-type') || 'new_purchase',
          btn.getAttribute('data-order-plan') || 'standard'
        );
      });
    });

    // Ouverture directe si on arrive via ?renew=1 (lien du footer)
    const params = new URLSearchParams(window.location.search);
    if (params.get('renew') === '1') {
      configureModal('renewal', 'standard');
      window.setTimeout(() => {
        window.HSOverlay?.open(modal);
      }, 150);
    }

    form.addEventListener('submit', async event => {
      event.preventDefault();
      clearErrors();

      const type = typeHidden.value;
      const formData = new FormData(form);
      const buyerName = (formData.get('buyerName') || '').toString().trim();
      const buyerEmail = (formData.get('buyerEmail') || '').toString().trim();
      const schoolName = (formData.get('schoolName') || '').toString().trim();
      const buyerPhone = (formData.get('buyerPhone') || '').toString().trim();
      const schoolAddress = (formData.get('schoolAddress') || '')
        .toString()
        .trim();
      const existingLicenseKey = (formData.get('existingLicenseKey') || '')
        .toString()
        .trim()
        .toUpperCase();
      const plan =
        type === 'renewal' ? planInput.value : planHidden.value;

      // Validation côté client, alignée sur les règles du backend
      let hasError = false;
      if (buyerName.length < 2 || buyerName.length > 255) {
        showFieldError('buyerName', 'Merci d’indiquer le nom du responsable (2 caractères minimum).');
        hasError = true;
      }
      if (!EMAIL_REGEX.test(buyerEmail)) {
        showFieldError('buyerEmail', 'Adresse e-mail invalide.');
        hasError = true;
      }
      if (buyerPhone && !/^[0-9]{6,30}$/.test(buyerPhone)) {
        showFieldError(
          'buyerPhone',
          'Chiffres uniquement, sans + ni espaces (ex. 22997000000).'
        );
        hasError = true;
      }
      if (type === 'renewal' && !LICENSE_KEY_REGEX.test(existingLicenseKey)) {
        showFieldError(
          'existingLicenseKey',
          'Format attendu : AF-XXXX-XXXX-XXXX-XXXX.'
        );
        hasError = true;
      }
      if (hasError) return;

      let payload;
      let endpoint;
      if (type === 'trial') {
        // /trial n'attend ni type, ni plan, ni existingLicenseKey
        payload = { buyerName, buyerEmail };
        endpoint = `${BACKEND_URL}/trial`;
      } else {
        payload = { type, plan, buyerName, buyerEmail };
        if (type === 'renewal') payload.existingLicenseKey = existingLicenseKey;
        endpoint = `${BACKEND_URL}/orders`;
      }
      if (schoolName) payload.schoolName = schoolName;
      if (buyerPhone) payload.buyerPhone = buyerPhone;
      if (schoolAddress) payload.schoolAddress = schoolAddress;

      setLoading(true);
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
          if (response.status === 400 && data.details) {
            const fieldErrors = data.details.fieldErrors || data.details;
            let shownAny = false;
            Object.entries(fieldErrors).forEach(([field, message]) => {
              const msg = Array.isArray(message) ? message[0] : message;
              if (showFieldError(field, String(msg))) shownAny = true;
            });
            if (!shownAny) showBannerError(data.error || 'Requête invalide.');
          } else if (response.status === 404) {
            showFieldError(
              'existingLicenseKey',
              data.error || 'Licence à renouveler introuvable.'
            );
          } else if (response.status === 409) {
            if (type === 'trial') {
              showFieldError(
                'buyerEmail',
                data.error ||
                  'Un essai gratuit a déjà été utilisé avec cette adresse e-mail.'
              );
            } else {
              showBannerError(data.error || 'Conflit sur cette commande.');
            }
          } else {
            showBannerError(
              data.error || 'Impossible de créer la commande pour le moment.'
            );
          }
          setLoading(false);
          return;
        }

        if (type === 'trial') {
          const expiry = data.expiresAt
            ? new Date(data.expiresAt).toLocaleDateString('fr-FR', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
              })
            : null;
          successMessage.textContent = expiry
            ? `${data.message || 'Essai gratuit de 5 jours activé.'} Il expire le ${expiry}.`
            : data.message ||
              'Essai gratuit de 5 jours activé. Vérifie ta boîte mail.';
          formWrapper.classList.add('hidden');
          successView.classList.remove('hidden');
          setLoading(false);
        } else if (data.redirectUrl) {
          window.location.href = data.redirectUrl;
        } else {
          showBannerError('Réponse inattendue du serveur. Merci de réessayer.');
          setLoading(false);
        }
      } catch (err) {
        showBannerError(
          'Impossible de contacter le serveur. Vérifie ta connexion et réessaie.'
        );
        setLoading(false);
      }
    });
  });
</script>
